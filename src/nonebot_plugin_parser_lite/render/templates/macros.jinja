{# 环境光层 #}
{% macro resolve_cover_src(result) -%}
    {% set cover = namespace(src=none) -%}
    {% for item in result.content if not cover.src -%}
        {% set cls = item.__class__.__name__ if item is not string else 'str' -%}
        {% if cls == 'VideoContent' -%}
            {% set cover.src = item | safe_src("get_cover_path", return_none_on_fail=True) -%}
        {% elif cls == 'LivePhotoContent' -%}
            {% set cover.src = item | safe_src("get_base", return_none_on_fail=True) -%}
        {% elif cls in ['ImageContent', 'GraphicContent'] -%}
            {% set cover.src = item | safe_src(return_none_on_fail=True) -%}
        {% endif -%}
    {% endfor -%}
    {{- cover.src or '' -}}
{%- endmacro %}
{% macro render_ambient(cover_src, logo_src) %}
    {% if cover_src %}<img src="{{ cover_src }}" alt="" class="ambient-cover" />{% endif %}
    {% if logo_src %}
        <img src="{{ logo_src }}" alt="" class="logo-light logo-light-top" />
        <img src="{{ logo_src }}" alt="" class="logo-light logo-light-middle" />
        <img src="{{ logo_src }}" alt="" class="logo-light logo-light-bottom" />
    {% endif %}
    <div class="ambient-wash"></div>
{% endmacro %}
{# 1. 统计宏（Tailwind 样式） #}
{% macro render_stats(stats) %}
    <div class="flex flex-wrap items-end gap-x-8 gap-y-5 px-8 pt-5 pb-4"
         style="grid-template-columns: repeat(auto-fit, minmax(100px, 1fr))">
        {% if stats.view_count and stats.view_count != '-' %}
            <div class="min-w-[92px]">
                <div class="flex items-center gap-1.5 text-xs font-semibold text-slate-500 dark:text-slate-400"><i class="fa-icon stat-icon fa-eye"></i><span>浏览</span></div>
                <div class="mt-1 text-xl font-black leading-none text-gray-800 dark:text-slate-100">{{ stats.view_count }}</div>
            </div>
        {% endif %}
        {% if stats.like_count and stats.like_count != '-' %}
            <div class="min-w-[92px]">
                <div class="flex items-center gap-1.5 text-xs font-semibold text-slate-500 dark:text-slate-400"><i class="fa-icon stat-icon fa-heart"></i><span>点赞</span></div>
                <div class="mt-1 text-xl font-black leading-none text-gray-800 dark:text-slate-100">{{ stats.like_count }}</div>
            </div>
        {% endif %}
        {% if stats.comment_count and stats.comment_count != '-' %}
            <div class="min-w-[92px]">
                <div class="flex items-center gap-1.5 text-xs font-semibold text-slate-500 dark:text-slate-400"><i class="fa-icon stat-icon fa-comment-dots"></i><span>评论</span></div>
                <span class="mt-1 block text-xl font-black leading-none text-gray-800 dark:text-slate-100">{{ stats.comment_count }}</span>
            </div>
        {% endif %}
        {% if stats.collect_count and stats.collect_count != '-' %}
            <div class="min-w-[92px]">
                <div class="flex items-center gap-1.5 text-xs font-semibold text-slate-500 dark:text-slate-400"><i class="fa-icon stat-icon fa-star"></i><span>收藏</span></div>
                <span class="mt-1 block text-xl font-black leading-none text-gray-800 dark:text-slate-100">{{ stats.collect_count }}</span>
            </div>
        {% endif %}
        {% if stats.share_count and stats.share_count != '-' %}
            <div class="min-w-[92px]">
                <div class="flex items-center gap-1.5 text-xs font-semibold text-slate-500 dark:text-slate-400"><i class="fa-icon stat-icon fa-share-nodes"></i><span>分享</span></div>
                <span class="mt-1 block text-xl font-black leading-none text-gray-800 dark:text-slate-100">{{ stats.share_count }}</span>
            </div>
        {% endif %}
        {# 遍历 extra：图标类名 fa-字段名，值为 stats.extra[key] #}
        {% if stats.extra %}
            {% for key, value in stats.extra.items() %}
                {% if value and value != '-' %}
                    <div class="min-w-[92px]">
                        <div class="flex items-center gap-1.5 text-xs font-semibold text-slate-500 dark:text-slate-400"><i class="fa-icon stat-icon fa-{{ key }}"></i><span>{{ key }}</span></div>
                        <span class="mt-1 block text-xl font-black leading-none text-gray-800 dark:text-slate-100">{{ value }}</span>
                    </div>
                {% endif %}
            {% endfor %}
        {% endif %}
    </div>
{% endmacro %}
{# 2. 评论宏（Tailwind 样式） #}
{% macro render_comments(comments) %}
    {% if comments and comments|length > 0 %}
        <div class="px-8 pb-10 space-y-6">
            <h4 class="text-lg font-black text-gray-500 dark:text-slate-400 border-gray-100 dark:border-slate-700 pb-1">评论</h4>
            {% for comment in comments %}
                <div class="comment space-y-3 flex space-x-2">
                    <img src="{{ comment.author | safe_src('get_avatar_path') }}"
                         class="w-10 h-10 rounded-full object-cover" />
                    <div class="content">
                        <div class="text-sm font-black text-gray-500 dark:text-slate-300">{{ comment.author.name }}</div>
                        <div class="text-sm text-gray-700 dark:text-slate-200 leading-relaxed">
                            {{ render_content_items(comment.content) }}
                        </div>
                        <div class="flex items-center space-x-2 text-xs text-gray-400 dark:text-slate-500 uppercase tracking-tight">
                            <span>{{ comment.formatted_datetime }}</span>
                            {% if comment.author.location %}<span>{{ comment.author.location }}</span>{% endif %}
                            {% if comment.stats.like_count %}
                                <span class="flex items-center">
                                    <i class="fa-icon fa-heart mr-1 mt-0.5"></i> {{ comment.stats.like_count }}
                                </span>
                            {% endif %}
                            {% if comment.stats.comment_count %}
                                <span class="flex items-center">
                                    <i class="fa-icon fa-comment-dots mr-1 mt-0.5"></i> {{ comment.stats.comment_count }}
                                </span>
                            {% endif %}
                        </div>
                        {% if comment.replies and comment.replies|length > 0 %}
                            <div class="comment mt-3 space-y-3">
                                {% for reply in comment.replies[:5] %}
                                    <div class="space-y-1.5 flex space-x-2">
                                        <img src="{{ reply.author | safe_src('get_avatar_path') }}"
                                             class="w-6 h-6 rounded-full object-cover" />
                                        <div class="content">
                                            <div class="text-sm font-bold text-gray-500 dark:text-slate-300">{{ reply.author.name }}</div>
                                            <div class="text-sm text-gray-600 dark:text-slate-300 leading-snug">{{ render_content_items(reply.content) }}</div>
                                            <div class="flex items-center space-x-3 text-xs text-gray-400 dark:text-slate-500 uppercase">
                                                <span>{{ reply.formatted_datetime }}</span>
                                                {% if reply.author.location %}<span>{{ reply.author.location }}</span>{% endif %}
                                                {% if reply.stats.like_count %}
                                                    <span class="flex items-center">
                                                        <i class="fa-icon fa-heart mr-1 mt-0.5"></i> {{ reply.stats.like_count }}
                                                    </span>
                                                {% endif %}
                                                {% if reply.stats.comment_count %}
                                                    <span class="flex items-center">
                                                        <i class="fa-icon fa-comment-dots mr-1 mt-0.5"></i> {{ reply.stats.comment_count }}
                                                    </span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endmacro %}
{% set MAX_VISIBLE_IMAGES = 9 %}
{# 图片布局：仿 new.html 的 1 / 2 / 3 / 9 图效果 #}
{% macro build_images(img_list, full_bleed=False) %}
    {% set count = img_list|length %}
    {% set visible_imgs = img_list[:MAX_VISIBLE_IMAGES] %}
    {% set hidden_count = (count - MAX_VISIBLE_IMAGES) if count > MAX_VISIBLE_IMAGES else 0 %}
    {# 单图：大图 + live #}
    {% if count == 1 %}
        {% set item = visible_imgs[0] %}
        {% set src = item.src %}
        {% set is_live = item.is_live %}
        <div class="media-shell {{ 'poster-media' if full_bleed else '' }} mt-4">
            <img src="{{ src }}" alt="" class="media-glow" />
            <div class="media-foreground single-image relative overflow-hidden inline-block">
                <img src="{{ src }}" class="w-full h-auto max-h-[400px] object-cover" />
            </div>
            {% if is_live %}
                <div class="media-overlay">
                    <div class="live-tag-strict absolute bottom-2 right-2 flex items-center">
                        <i class="live-icon"
                           style="width: 16px;
                                  height: 17px"
                           aria-hidden="true"></i>
                        <span class="text-[9px] font-bold uppercase tracking-widest"
                              style="padding-left: 1.3px">Live</span>
                    </div>
                </div>
            {% endif %}
        </div>
        {# 2 / 4 张使用两列，3 张使用单行三列 #}
    {% elif count <= 4 %}
        {% set grid_cols = "grid-cols-3" if count == 3 else "grid-cols-2" %}
        <div class="media-shell {{ 'poster-media' if full_bleed else '' }} mt-4">
            <img src="{{ visible_imgs[0].src }}" alt="" class="media-glow" />
            <div class="media-foreground media-grid overflow-hidden grid {{ grid_cols }} gap-[2px]">
                {% for item in visible_imgs %}
                    {% set src = item.src %}
                    {% set is_live = item.is_live %}
                    <div class="relative w-full h-full">
                        <img src="{{ src }}" class="square-img" />
                    </div>
                {% endfor %}
            </div>
            <div class="media-overlay media-grid grid {{ grid_cols }} gap-[2px]">
                {% for item in visible_imgs %}
                    <div class="relative w-full h-full">
                        {% if item.is_live %}
                            <div class="live-tag-strict absolute bottom-2 right-2 flex items-center">
                                <i class="live-icon"
                                   style="width: 16px;
                                          height: 17px"
                                   aria-hidden="true"></i>
                                <span class="text-[9px] font-bold uppercase tracking-widest"
                                      style="padding-left: 1.3px">实况</span>
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
        {# 其他 ≥5 张：九宫格 media-grid #}
    {% else %}
        <div class="media-shell {{ 'poster-media' if full_bleed else '' }} mt-4">
            <img src="{{ visible_imgs[0].src }}" alt="" class="media-glow" />
            <div class="media-foreground media-grid overflow-hidden grid grid-cols-3 gap-[2px]">
                {% for item in visible_imgs %}
                    {% set src = item.src %}
                    {% set is_live = item.is_live %}
                    {% if loop.index < MAX_VISIBLE_IMAGES or hidden_count == 0 %}
                        <div class="relative w-full h-full">
                            <img src="{{ src }}" class="square-img" />
                        </div>
                    {% else %}
                        {# 最后一张：+N 覆盖层 #}
                        <div class="relative w-full h-full">
                            <img src="{{ src }}" class="square-img" />
                            <div class="absolute inset-0 bg-black/60 flex items-center justify-center">
                                <span class="text-white text-[22px] font-black tracking-tighter">+{{ hidden_count }}</span>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
            <div class="media-overlay media-grid grid grid-cols-3 gap-[2px]">
                {% for item in visible_imgs %}
                    <div class="relative w-full h-full">
                        {% if item.is_live and (loop.index < MAX_VISIBLE_IMAGES or hidden_count == 0) %}
                            <div class="live-tag-strict absolute bottom-2 right-2 flex items-center">
                                <i class="live-icon"
                                   style="width: 16px;
                                          height: 17px"
                                   aria-hidden="true"></i>
                                <span class="text-[9px] font-bold uppercase tracking-widest"
                                      style="padding-left: 1.3px">Live</span>
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% endmacro %}
{# 投票内容 #}
{% macro render_poll(poll) %}
    {% set option_vote_total = poll.option_vote_total %}
    <div class="mt-4 border-y border-slate-100 py-3 dark:border-slate-700">
        <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 text-sm font-semibold leading-snug text-slate-800 dark:text-slate-100">{{ (poll.title or '投票') | e }}</div>
            <div class="shrink-0 text-xs font-medium {{ 'text-slate-400 dark:text-slate-500' if poll.closed else 'text-emerald-600 dark:text-emerald-400' }}">
                {{ '已结束' if poll.closed else '进行中' }}
            </div>
        </div>
        <div class="mt-2.5 space-y-2.5">
            {% for option in poll.options %}
                {% set percentage = poll.option_percentage(option, option_vote_total) %}
                <div>
                    <div class="mb-1 flex items-baseline justify-between gap-3 text-xs">
                        <span class="min-w-0 text-slate-700 dark:text-slate-200">{{ option.text | e }}</span>
                        <span class="shrink-0 font-medium text-slate-500 dark:text-slate-400">{{ option.votes }} 票 · {{ '%.1f' | format(percentage) }}%</span>
                    </div>
                    <div class="h-1.5 overflow-hidden rounded-sm bg-slate-200 dark:bg-slate-700">
                        <div class="h-full rounded-sm bg-cyan-600 dark:bg-cyan-500" style="width: {{ '%.2f' | format(percentage) }}%"></div>
                    </div>
                </div>
            {% endfor %}
        </div>
        <div class="mt-2.5 flex gap-2 text-xs text-slate-500 dark:text-slate-400">
            {% if poll.total_voters is not none %}<span>{{ poll.total_voters }} 人参与</span>{% endif %}
            {% if poll.multiple %}<span>多选</span>{% endif %}
            {% if poll.total_votes is not none and poll.total_votes != poll.total_voters %}<span>{{ poll.total_votes }} 票</span>{% endif %}
        </div>
    </div>
{% endmacro %}
{# 内容渲染（Tailwind 版本） #}
{% macro render_content_items(content, full_bleed=False) %}
    {% set html_parts = [] %}
    {% set ns = namespace(current_imgs=[], current_img_index=0) %}
    {% macro flush_images() %}
        {% if ns.current_imgs %}
            {% set _ = html_parts.append(build_images(ns.current_imgs, full_bleed)) %}
            {% set ns.current_imgs = [] %}
            {% set ns.current_img_index = 0 %}
        {% endif %}
    {% endmacro %}
    {% for cont in content %}
        {% set cls = cont.__class__.__name__ if cont is not string else 'str' %}
        {# 1. 图片类：积累，最后统一 flush 成宫格 #}
        {% if cls == 'ImageContent' %}
            {% set src = cont | safe_src if ns.current_img_index < MAX_VISIBLE_IMAGES else "" %}
            {% set _ = ns.current_imgs.append({'src': src, 'is_live' : false}) %}
            {% set ns.current_img_index = ns.current_img_index + 1 %}
        {% elif cls=='LivePhotoContent' %}
            {% set src = cont | safe_src("get_base") if ns.current_img_index < MAX_VISIBLE_IMAGES else "" %}
            {% set _ = ns.current_imgs.append({'src': src, 'is_live' : true}) %}
            {% set ns.current_img_index = ns.current_img_index + 1 %}
            {# 2. 文本：遇到非图片前先 flush，避免跨段 #}
        {% elif cont is string %}
            {% set _ = flush_images() %}
            {% set text = cont | e %}
            {# 换行完全由文本中的 \n 控制 #}
            {% set _ = html_parts.append('<span class="whitespace-pre-wrap text-sm text-slate-800 dark:text-slate-200">' ~ text ~ '</span>') %}
            {# 3. Graphic 图文 #}
        {% elif cls == 'GraphicContent' %}
            {% set _ = flush_images() %}
            {% set src = cont | safe_src %}
            {% set alt = cont.alt or "" %}
            {% set _ = html_parts.append(
                            '<div class="media-shell ' ~ ('poster-media ' if full_bleed else '') ~ 'mt-3 space-y-1">'
                            '<img src="' ~ src ~ '" alt="" class="media-glow" />'
                            '<div class="media-foreground single-image relative overflow-hidden">'
                            '<img src="' ~ src ~ '" class="w-full h-auto object-cover" />'
                            '</div>'
                            '<p class="whitespace-pre-wrap text-xs text-slate-500 dark:text-slate-400">' ~ (alt|e) ~ '</p>'
                            '</div>'
                        ) %}
            {# 4. 贴纸 #}
        {% elif cls == 'StickerContent' %}
            {% set src = cont | safe_src(return_none_on_fail=True) %}
            {% if not src %}
                {% set _ = html_parts.append('<span class="whitespace-pre-wrap text-sm text-slate-800 dark:text-slate-200">' ~ cont.desc|e ~ '</span>') %}
            {% else %}
                {% set size = cont.size %}
                {% set size_class = 'h-6' if size == 'small' else 'h-12' %}
                {% set _ = html_parts.append(
                                    '<img class="inline-block align-text-bottom ' ~ size_class ~ '"
                     src="' ~ src ~ '"
                     alt="' ~ (cont.desc|e) ~ '" />'
                                ) %}
            {% endif %}
            {# 5. 视频封面 + 播放按钮 #}
        {% elif cls == 'VideoContent' %}
            {% set _ = flush_images() %}
            {% set src = cont | safe_src("get_cover_path") %}
            {% set _ = html_parts.append(
                            '<div class="media-shell ' ~ ('poster-media ' if full_bleed else '') ~ 'mt-3">'
                            '<img src="' ~ src ~ '" alt="" class="media-glow" />'
                            '<div class="media-foreground poster-video relative overflow-hidden bg-black">'
                            '<img src="' ~ src ~ '" class="w-full h-full object-cover opacity-80" />'
                            '</div>'
                            '<div class="media-overlay">'
                            '<div class="video-meta">'
                            '<span>' ~ cont.display_duration ~ '</span>'
                            '<span class="video-meta-size">' ~ cont.get_display_size() ~ '</span>'
                            '</div>'
                            '<i class="fa-icon fa-play video-playmark"></i>'
                            '</div>'
                            '</div>'
                        ) %}
            {# 6. 链接卡片 #}
        {% elif cls == 'LinkContent' %}
            {% set _ = flush_images() %}
            {% set icon_src = cont | safe_src("get_icon_path", return_none_on_fail=True) %}
            {% set preview_src = cont | safe_src("get_preview_path", return_none_on_fail=True) %}
            {% set rich_link = cont.site_name or cont.description or icon_src or preview_src %}
            {% set preview_html = '<img src="' ~ preview_src ~ '" class="h-auto object-contain" />' if preview_src else '' %}
            {% set icon_html = '<img src="' ~ icon_src ~ '" class="h-4 w-4 shrink-0 rounded-[2px] object-cover" />' if icon_src else '' %}
            {% set source_html = '<div class="mb-1.5 flex items-center gap-1.5 text-xs font-medium text-slate-500 dark:text-slate-400">' ~ icon_html ~ '<span class="truncate">' ~ ((cont.site_name or cont.url)|e) ~ '</span></div>' if rich_link else '' %}
            {% set description_html = '<div class="mt-1 text-xs leading-relaxed text-slate-500 line-clamp-2 dark:text-slate-400">' ~ (cont.description|e) ~ '</div>' if cont.description else '' %}
            {% set url_html = '' if rich_link else '<div class="mt-0.5 text-xs text-slate-500 dark:text-slate-400 line-clamp-2">' ~ (cont.url|e) ~ '</div>' %}
            {% set _ = html_parts.append(
                            '<a href="'~(cont.url|e)~'"
               target="_blank"
               rel="noreferrer noopener"
               class="mt-3 inline-block overflow-hidden border-y border-slate-100 bg-slate-50/50 transition-colors max-w-full duration-150 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800/40 dark:hover:bg-slate-800">'
                            ~ preview_html ~
                            '<div class="w-full px-3 py-2.5">'
                                ~ source_html ~
                                '<div class="text-sm font-semibold leading-snug text-slate-800 line-clamp-2 dark:text-slate-100">' ~ (cont.title|e) ~ '</div>'
                                ~ description_html ~ url_html ~
                            '</div>
                        </a>'
                    ) %}
        {% elif cls == 'QuoteContent' %}
            {% set _ = flush_images() %}
            {% set icon_src = cont | safe_src("get_icon_path", return_none_on_fail=True) %}
            {% set quote_title = cont.title or cont.url or '引用内容' %}
            {% set icon_html = '<img src="' ~ icon_src ~ '" class="h-5 w-5 shrink-0 rounded-[2px] object-cover" />' if icon_src else '' %}
            {% if cont.url %}
                {% set title_html = '<a href="' ~ (cont.url|e) ~ '" target="_blank" rel="noreferrer noopener" class="min-w-0 truncate text-xs font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">' ~ (quote_title|e) ~ '</a>' %}
            {% else %}
                {% set title_html = '<span class="min-w-0 truncate text-xs font-semibold text-slate-600 dark:text-slate-300">' ~ (quote_title|e) ~ '</span>' %}
            {% endif %}
            {% set _ = html_parts.append(
                            '<div class="mt-3 border-l-[3px] border-slate-300 py-1 pl-3 dark:border-slate-600">'
                            '<div class="flex items-center gap-2">' ~ icon_html ~ title_html ~ '</div>'
                            '<div class="mt-1 whitespace-pre-wrap text-sm leading-relaxed text-slate-600 dark:text-slate-300">' ~ (cont.text|e) ~ '</div>'
                            '</div>'
                        ) %}
        {% elif cls == 'PollContent' %}
            {% set _ = flush_images() %}
            {% set _ = html_parts.append(render_poll(cont)) %}
    {% endif %}
{% endfor %}
{% set _ = flush_images() %}
{{ html_parts|join("") | safe }}
{% endmacro %}
{# 3. 内容+转发宏（Tailwind 样式 + is_repost） #}
{% macro render_content(result, is_repost=False) %}
    {% set comments = result.comments %}
    <div class="{{ 'w-full' if is_repost else 'w-[620px]' }} overflow-hidden flex flex-col">
        {# Header #}
        <div class="px-8 pt-10 pb-3 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <img src="{{ result.author | safe_src('get_avatar_path') }}"
                     class="w-12 h-12 rounded-full object-cover" />
                <div>
                    <div class="flex items-center space-x-2">
                        <h2 class="text-xl font-black text-slate-800 dark:text-slate-100 leading-none">{{ result.author.name }}</h2>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 font-medium space-x-2">
                        <span>{{ result.formatted_datetime }}</span>
                        {% if result.author.location %}<span>{{ result.author.location }}</span>{% endif %}
                    </p>
                </div>
            </div>
            {% if not is_repost %}
                <div class="flex items-center space-x-1.5 px-4 py-2">
                    <img src="{{ result.platform | safe_src('get_logo_path') }}"
                         class="w-4 h-4 rounded-[2px]" />
                    <span class="text-xs font-black text-gray-500 dark:text-slate-300 tracking-widest">{{ result.platform.display_name }}</span>
                </div>
            {% endif %}
        </div>
        <div class="px-8 space-y-3 pb-5">
            {% if result.title %}
                <p class="title text-2xl font-black leading-tight text-gray-800 dark:text-slate-100">{{ result.title | e }}</p>
            {% endif %}
            <div class="text-gray-800 dark:text-slate-200 text-base leading-relaxed">
                {{ render_content_items(result.content, not is_repost) }}
            </div>
        </div>
        {{ render_stats(result.stats) }}
        {# AI 总结 / 锐评 #}
        {% if result.ai_summary %}
            <div class="px-8 pb-5">
                <div class="flex items-start space-x-2.5 border-l-2 border-indigo-400 py-1 pl-3 dark:border-indigo-500">
                    <div class="mt-0.5 flex h-7 w-7 items-center justify-center rounded-full bg-indigo-500">
                        <i class="fa-icon fa-wand-magic-sparkles text-sm"></i>
                    </div>
                    <div class="flex-1">
                        <div class="text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-400 dark:text-slate-500 mb-0.5">
                            AI 总结
                        </div>
                        <p class="text-sm text-slate-700 dark:text-slate-200 leading-relaxed whitespace-pre-wrap">{{ result.ai_summary }}</p>
                    </div>
                </div>
            </div>
        {% endif %}
        {# 转发内容：使用引用式层级，避免嵌套卡片割裂主体 #}
        {% if result.repost %}
            <div class="mx-8 mb-6 border-l-2 border-slate-200 pl-3 dark:border-slate-700">
                {{ render_content(result.repost, True) }}
            </div>
        {% endif %}
        {# 主体内容和评论之间的间隔 #}
        {% if comments and comments|length > 0 %}
            <div class="px-8 mt-2 mb-4">
                <div class="h-px bg-slate-100 dark:bg-slate-700"></div>
            </div>
        {% endif %}
        {{ render_comments(comments) }}
        {% if not is_repost %}
            <div class="mx-8 mt-4 mb-7 flex items-end justify-between gap-6">
                <div class="flex min-w-0 items-center gap-3">
                    <img src="{{ result.author | safe_src('get_avatar_path') }}"
                         class="h-12 w-12 shrink-0 rounded-full object-cover" />
                    <div class="min-w-0">
                        <div class="truncate text-lg font-black text-slate-800 dark:text-slate-100">{{ result.author.name }}</div>
                        <div class="mt-1 truncate text-xs text-slate-500 dark:text-slate-400">
                            {% if result.author.location %}{{ result.author.location }}{% endif %}
                            {% if result.author.location and result.author.id %} · {% endif %}
                            {% if result.author.id %}ID: {{ result.author.id }}{% endif %}
                        </div>
                    </div>
                </div>
                {% if result.qrcode_path %}
                    <img src="{{ result.qrcode_path }}" alt="二维码" class="h-24 w-24 shrink-0 rounded-lg" />
                {% endif %}
            </div>
            <footer class="mx-8 border-t border-gray-100 py-5 dark:border-slate-800 flex justify-between items-center text-[10px] font-black text-gray-300 dark:text-slate-600 uppercase tracking-widest antialiased">
                <span>{{ result.bot_name }} Parser · Design negichan</span>
                <span>Rendering at {{ result.rendering_time }}</span>
            </footer>
        {% endif %}
    </div>
{% endmacro %}
