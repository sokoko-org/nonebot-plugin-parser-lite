<!DOCTYPE html>
<html lang="zh-CN" data-theme="{{ theme }}">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{{ result.title }} - {{ result.author.name }}</title>
        <link rel="stylesheet" href="tailwind.css" />
        <link rel="stylesheet" href="ambient.css" />
        {% from "macros.jinja" import render_ambient, resolve_cover_src %}
        <style>
            body {
                width: 620px;
            }

            .cover-glow {
                position: absolute;
                inset: 8%;
                width: 84%;
                height: 84%;
                object-fit: cover;
                filter: blur(28px) saturate(1.55);
                opacity: 0.42;
                transform: translateY(12px);
            }

            [data-theme="dark"] .cover-glow {
                opacity: 0.62;
            }
        </style>
    </head>
    <body class="m-0 text-gray-800 dark:text-slate-100">
        {% set cover_src = resolve_cover_src(result) %}
        {% set logo_src = result.platform | safe_src('get_logo_path') %}
        <main class="ambient-canvas">
            {{ render_ambient(cover_src, logo_src) }}
            <div class="ambient-content p-6">
            {% if result.qr_code_path %}
                <img src="{{ result.qr_code_path }}"
                     alt="二维码"
                     class="absolute top-6 right-6 h-20 w-20 max-[600px]:h-[60px] max-[600px]:w-[60px]" />
            {% endif %}
            <div class="mb-6 flex items-start gap-5 pr-[100px] max-[600px]:pr-20">
                {% if cover_src %}
                    <div class="relative isolate h-[150px] w-[150px] shrink-0 max-[600px]:h-[120px] max-[600px]:w-[120px]">
                        <img src="{{ cover_src }}" alt="" class="cover-glow" />
                        <img src="{{ cover_src }}"
                             alt="专辑封面"
                             class="relative h-full w-full rounded-lg object-cover" />
                    </div>
                {% endif %}
                <div class="min-w-0 flex-1">
                    <h1 class="mb-2 truncate text-2xl font-semibold">{{ result.title }}</h1>
                    <p class="mb-2 truncate text-lg text-gray-600 dark:text-slate-300">{{ result.author.name }}</p>
                    {% if result.extra and result.extra.album %}
                        <p class="mb-3 truncate text-base text-gray-400 dark:text-slate-400">{{ result.extra.album }}</p>
                    {% endif %}
                    <div class="mt-2 inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 dark:text-slate-400">
                        <span class="h-1.5 w-1.5 rounded-full bg-sky-500"></span>
                        {{ result.platform.display_name }}
                    </div>
                </div>
            </div>
            {% if result.extra and result.extra.lyric %}
                <div class="my-6 border-t border-slate-100 pt-5 pr-[120px] dark:border-slate-800 max-[600px]:pr-0">
                    <h2 class="mb-4 text-lg font-semibold">歌词</h2>
                    <div class="max-h-none overflow-y-auto whitespace-pre-wrap border-l-2 border-sky-400 pl-4 text-base leading-[1.8] text-gray-700 dark:border-sky-500 dark:text-slate-200 dark:[color-scheme:dark]">{{ result.extra.lyric }}</div>
                </div>
            {% endif %}
            {% if result.extra.info %}
                <div class="absolute right-6 bottom-6 text-sm text-gray-500 dark:text-slate-400 max-[600px]:static max-[600px]:mt-4 max-[600px]:w-fit">
                    {{ result.extra.info }}
                </div>
            {% endif %}
            {% if result.url %}
                <div class="mt-5 break-all border-t border-slate-100 pt-4 text-sm text-gray-500 dark:border-slate-800 dark:text-slate-400">
                    来源链接:
                    <a href="{{ result.url }}"
                       target="_blank"
                       rel="noreferrer noopener"
                       class="text-sky-600 underline dark:text-sky-400">{{ result.url }}</a>
                </div>
            {% endif %}
            </div>
        </main>
    </body>
</html>
